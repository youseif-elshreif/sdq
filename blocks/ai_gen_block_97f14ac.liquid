{% doc %}
  @prompt
    Create a Size Chart accordion block for a product page. Before the "Size chart" title text, display the 📏 ruler emoji. When clicked, it expands to show: 1) An image picker setting so the merchant can upload a size chart photo (displayed full width, no table), 2) A rich text / textarea setting where the merchant can write custom notes or messages. No size table — only the image and the notes text box. The block should match a modern, clean product page style with smooth accordion open/ close animation.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-chart-accordion-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-size-chart-header-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    padding: 16px 20px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    text-align: left;
    transition: background-color 0.3s ease;
  }

  .ai-size-chart-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_background }};
  }

  .ai-size-chart-title-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-size-chart-emoji-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    line-height: 1;
  }

  .ai-size-chart-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .ai-size-chart-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.header_text_color }};
  }

  .ai-size-chart-header-{{ ai_gen_id }}[aria-expanded="true"] .ai-size-chart-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-size-chart-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    background-color: {{ block.settings.content_background }};
  }

  .ai-size-chart-content-{{ ai_gen_id }}.active {
    max-height: 2000px;
    padding: 20px;
  }

  .ai-size-chart-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 16px;
  }

  .ai-size-chart-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-size-chart-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    position: relative;
  }

  .ai-size-chart-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-size-chart-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-size-chart-notes-{{ ai_gen_id }} {
    color: {{ block.settings.notes_text_color }};
    font-size: {{ block.settings.notes_font_size }}px;
    line-height: 1.6;
  }

  .ai-size-chart-notes-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-size-chart-notes-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-size-chart-accordion-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-size-chart-header-{{ ai_gen_id }} {
      padding: 14px 16px;
    }

    .ai-size-chart-content-{{ ai_gen_id }}.active {
      padding: 16px;
    }
  }
{% endstyle %}

<size-chart-accordion-{{ ai_gen_id }}
  class="ai-size-chart-accordion-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <button
    class="ai-size-chart-header-{{ ai_gen_id }}"
    aria-expanded="false"
    aria-controls="ai-size-chart-content-{{ ai_gen_id }}"
  >
    <div class="ai-size-chart-title-wrapper-{{ ai_gen_id }}">
      <span class="ai-size-chart-emoji-{{ ai_gen_id }}">📏</span>
      <span>{{ block.settings.title }}</span>
    </div>
    <div class="ai-size-chart-icon-{{ ai_gen_id }}">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </button>

  <div
    id="ai-size-chart-content-{{ ai_gen_id }}"
    class="ai-size-chart-content-{{ ai_gen_id }}"
  >
    {% if block.settings.size_chart_image != blank or block.settings.notes != blank %}
      {% if block.settings.size_chart_image != blank %}
        <div class="ai-size-chart-image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.size_chart_image | image_url: width: 1200 }}"
            alt="{{ block.settings.size_chart_image.alt | default: 'Size chart' | escape }}"
            class="ai-size-chart-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.size_chart_image.width }}"
            height="{{ block.settings.size_chart_image.height }}"
          >
        </div>
      {% else %}
        <div class="ai-size-chart-image-wrapper-{{ ai_gen_id }}">
          <div class="ai-size-chart-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-size-chart-empty-state-{{ ai_gen_id }}">
              Next, add a size chart image
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.notes != blank %}
        <div class="ai-size-chart-notes-{{ ai_gen_id }}">
          {{ block.settings.notes }}
        </div>
      {% endif %}
    {% else %}
      <div class="ai-size-chart-image-wrapper-{{ ai_gen_id }}">
        <div class="ai-size-chart-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-size-chart-empty-state-{{ ai_gen_id }}">
            Next, add a size chart image or notes
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</size-chart-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class SizeChartAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-size-chart-header-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-size-chart-content-{{ ai_gen_id }}');

        if (this.button && this.content) {
          this.button.addEventListener('click', this.toggle.bind(this));
        }
      }

      toggle() {
        const isExpanded = this.button.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          this.button.setAttribute('aria-expanded', 'false');
          this.content.classList.remove('active');
        } else {
          this.button.setAttribute('aria-expanded', 'true');
          this.content.classList.add('active');
        }
      }
    }

    customElements.define('size-chart-accordion-{{ ai_gen_id }}', SizeChartAccordion{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Size chart",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Size chart"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "size_chart_image",
      "label": "Size chart image"
    },
    {
      "type": "richtext",
      "id": "notes",
      "label": "Notes",
      "default": "<p>Measurements are in inches. For the best fit, please refer to the chart above.</p>"
    },
    {
      "type": "range",
      "id": "notes_font_size",
      "label": "Notes size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_hover_background",
      "label": "Header hover background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "notes_text_color",
      "label": "Notes text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Size chart"
    }
  ]
}
{% endschema %}

{% doc %}
  @prompt
    Create a Size Chart accordion block for a product page. Before the "Size chart" title text, display the 📏 ruler emoji. When clicked, it expands to show an image (with an image picker setting so the merchant can upload their size chart photo) followed by a size chart table. The block should match a modern, clean product page style.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-chart-accordion-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-size-chart-header-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 20px;
    background-color: {{ block.settings.header_background }};
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-size-chart-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_background }};
  }

  .ai-size-chart-title-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-size-chart-emoji-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    line-height: 1;
  }

  .ai-size-chart-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-size-chart-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    color: {{ block.settings.title_color }};
  }

  .ai-size-chart-icon-{{ ai_gen_id }}.open {
    transform: rotate(180deg);
  }

  .ai-size-chart-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background-color: {{ block.settings.content_background }};
  }

  .ai-size-chart-content-{{ ai_gen_id }}.open {
    max-height: 2000px;
  }

  .ai-size-chart-inner-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-size-chart-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-size-chart-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-size-chart-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .ai-size-chart-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 200px;
  }

  .ai-size-chart-table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
  }

  .ai-size-chart-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    font-size: {{ block.settings.table_text_size }}px;
  }

  .ai-size-chart-table-{{ ai_gen_id }} th,
  .ai-size-chart-table-{{ ai_gen_id }} td {
    padding: 12px 16px;
    text-align: left;
    border: 1px solid {{ block.settings.table_border_color }};
  }

  .ai-size-chart-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.table_header_background }};
    color: {{ block.settings.table_header_text_color }};
    font-weight: 600;
  }

  .ai-size-chart-table-{{ ai_gen_id }} td {
    background-color: {{ block.settings.table_cell_background }};
    color: {{ block.settings.table_cell_text_color }};
  }

  .ai-size-chart-table-{{ ai_gen_id }} tbody tr:nth-child(even) td {
    background-color: {{ block.settings.table_row_alt_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-size-chart-accordion-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-size-chart-header-{{ ai_gen_id }} {
      padding: 14px 16px;
    }

    .ai-size-chart-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-size-chart-table-{{ ai_gen_id }} th,
    .ai-size-chart-table-{{ ai_gen_id }} td {
      padding: 10px 12px;
      font-size: {{ block.settings.table_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<size-chart-accordion-{{ ai_gen_id }}
  class="ai-size-chart-accordion-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <button
    class="ai-size-chart-header-{{ ai_gen_id }}"
    aria-expanded="false"
    aria-controls="ai-size-chart-content-{{ ai_gen_id }}"
  >
    <div class="ai-size-chart-title-wrapper-{{ ai_gen_id }}">
      <span class="ai-size-chart-emoji-{{ ai_gen_id }}">📏</span>
      <h3 class="ai-size-chart-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
    </div>
    <svg
      class="ai-size-chart-icon-{{ ai_gen_id }}"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div
    id="ai-size-chart-content-{{ ai_gen_id }}"
    class="ai-size-chart-content-{{ ai_gen_id }}"
  >
    <div class="ai-size-chart-inner-{{ ai_gen_id }}">
      {% if block.settings.size_chart_image %}
        <div class="ai-size-chart-image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.size_chart_image | image_url: width: 1200 }}"
            alt="{{ block.settings.size_chart_image.alt | default: 'Size chart' | escape }}"
            loading="lazy"
            width="{{ block.settings.size_chart_image.width }}"
            height="{{ block.settings.size_chart_image.height }}"
            class="ai-size-chart-image-{{ ai_gen_id }}"
          >
        </div>
      {% endif %}

      <div class="ai-size-chart-table-wrapper-{{ ai_gen_id }}">
        <table class="ai-size-chart-table-{{ ai_gen_id }}">
          <thead>
            <tr>
              <th>{{ block.settings.column_1_header }}</th>
              <th>{{ block.settings.column_2_header }}</th>
              <th>{{ block.settings.column_3_header }}</th>
              <th>{{ block.settings.column_4_header }}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{{ block.settings.row_1_col_1 }}</td>
              <td>{{ block.settings.row_1_col_2 }}</td>
              <td>{{ block.settings.row_1_col_3 }}</td>
              <td>{{ block.settings.row_1_col_4 }}</td>
            </tr>
            <tr>
              <td>{{ block.settings.row_2_col_1 }}</td>
              <td>{{ block.settings.row_2_col_2 }}</td>
              <td>{{ block.settings.row_2_col_3 }}</td>
              <td>{{ block.settings.row_2_col_4 }}</td>
            </tr>
            <tr>
              <td>{{ block.settings.row_3_col_1 }}</td>
              <td>{{ block.settings.row_3_col_2 }}</td>
              <td>{{ block.settings.row_3_col_3 }}</td>
              <td>{{ block.settings.row_3_col_4 }}</td>
            </tr>
            <tr>
              <td>{{ block.settings.row_4_col_1 }}</td>
              <td>{{ block.settings.row_4_col_2 }}</td>
              <td>{{ block.settings.row_4_col_3 }}</td>
              <td>{{ block.settings.row_4_col_4 }}</td>
            </tr>
            <tr>
              <td>{{ block.settings.row_5_col_1 }}</td>
              <td>{{ block.settings.row_5_col_2 }}</td>
              <td>{{ block.settings.row_5_col_3 }}</td>
              <td>{{ block.settings.row_5_col_4 }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</size-chart-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class SizeChartAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-size-chart-header-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-size-chart-content-{{ ai_gen_id }}');
        this.icon = this.querySelector('.ai-size-chart-icon-{{ ai_gen_id }}');

        this.button.addEventListener('click', () => this.toggle());
      }

      toggle() {
        const isOpen = this.content.classList.contains('open');

        if (isOpen) {
          this.close();
        } else {
          this.open();
        }
      }

      open() {
        this.content.classList.add('open');
        this.icon.classList.add('open');
        this.button.setAttribute('aria-expanded', 'true');
      }

      close() {
        this.content.classList.remove('open');
        this.icon.classList.remove('open');
        this.button.setAttribute('aria-expanded', 'false');
      }
    }

    customElements.define('size-chart-accordion-{{ ai_gen_id }}', SizeChartAccordion{{ ai_gen_id }});
  })();
</script>


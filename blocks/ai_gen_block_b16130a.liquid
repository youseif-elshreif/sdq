      "type": "image_picker",
      "id": "size_chart_image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Table measurements"
    },
    {
      "type": "text",
      "id": "measurement_1_label",
      "label": "Measurement 1 label",
      "default": "Chest (cm)"
    },
    {
      "type": "text",
      "id": "measurement_2_label",
      "label": "Measurement 2 label",
      "default": "Waist (cm)"
    },
    {
      "type": "text",
      "id": "measurement_3_label",
      "label": "Measurement 3 label",
      "default": "Length (cm)"
    },
    {
      "type": "header",
      "content": "Size M"
    },
    {
      "type": "text",
      "id": "size_m_measurement_1",
      "label": "Measurement 1",
      "default": "96-101"
    },
    {
      "type": "text",
      "id": "size_m_measurement_2",
      "label": "Measurement 2",
      "default": "81-86"
    },
    {
      "type": "text",
      "id": "size_m_measurement_3",
      "label": "Measurement 3",
      "default": "71"
    },
    {
      "type": "header",
      "content": "Size L"
    },
    {
      "type": "text",
      "id": "size_l_measurement_1",
      "label": "Measurement 1",
      "default": "106-111"
    },
    {
      "type": "text",
      "id": "size_l_measurement_2",
      "label": "Measurement 2",
      "default": "91-96"
    },
    {
      "type": "text",
      "id": "size_l_measurement_3",
      "label": "Measurement 3",
      "default": "74"
    },
    {
      "type": "header",
      "content": "Size XL"
    },
    {
      "type": "text",
      "id": "size_xl_measurement_1",
      "label": "Measurement 1",
      "default": "116-121"
    },
    {
      "type": "text",
      "id": "size_xl_measurement_2",
      "label": "Measurement 2",
      "default": "101-106"
    },
    {
      "type": "text",
      "id": "size_xl_measurement_3",
      "label": "Measurement 3",
      "default": "77"
    },
    {
      "type": "header",
      "content": "Size XXL"
    },
    {
      "type": "text",
      "id": "size_xxl_measurement_1",
      "label": "Measurement 1",
      "default": "126-131"
    },
    {
      "type": "text",
      "id": "size_xxl_measurement_2",
      "label": "Measurement 2",
      "default": "111-116"
    },
    {
      "type": "text",
      "id": "size_xxl_measurement_3",
      "label": "Measurement 3",
      "default": "80"
    },
    {
      "type": "header",
      "content": "Custom note"
    },
    {
      "type": "textarea",
      "id": "custom_note",
      "label": "Note",
      "default": "All measurements are approximate. For the best fit, please measure yourself and compare with the size chart."
    }
  ],
  "presets": [
    {
      "name": "Size chart"
    }
  ]
}
{% endschema %}

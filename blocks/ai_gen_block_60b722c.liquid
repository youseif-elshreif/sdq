{% doc %}
  @prompt
    Create a custom product page block called "Color Swatches" that displays clickable color swatch buttons. Each swatch links to a separate product page URL. The block should allow merchants to add multiple swatches, each with a color name, a hex color value, and a URL to another product page. The currently active product's swatch should appear selected/highlighted. Swatches should be circular buttons styled to match a premium streetwear brand aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-color-swatches-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-color-swatches__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-color-swatches__label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    margin-bottom: {{ block.settings.label_spacing }}px;
    text-transform: {{ block.settings.label_transform }};
    letter-spacing: {{ block.settings.label_letter_spacing }}px;
  }

  .ai-color-swatches__grid-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.swatch_gap }}px;
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: 50%;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    overflow: hidden;
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.hover_shadow_opacity }});
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }}--active {
    border-color: {{ block.settings.active_border_color }};
    border-width: {{ block.settings.active_border_width }}px;
    box-shadow: 0 0 0 {{ block.settings.active_ring_width }}px {{ block.settings.active_ring_color }};
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }}--active:hover {
    transform: scale(1);
  }

  .ai-color-swatches__color-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-color-swatches__tooltip-{{ ai_gen_id }} {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.tooltip_bg }};
    color: {{ block.settings.tooltip_text }};
    padding: 6px 12px;
    border-radius: {{ block.settings.tooltip_radius }}px;
    font-size: {{ block.settings.tooltip_size }}px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
    z-index: 10;
  }

  .ai-color-swatches__swatch-{{ ai_gen_id }}:hover .ai-color-swatches__tooltip-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
  }

  @media screen and (max-width: 749px) {
    .ai-color-swatches__container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-color-swatches__swatch-{{ ai_gen_id }} {
      width: {{ block.settings.swatch_size | times: 0.9 }}px;
      height: {{ block.settings.swatch_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-color-swatches-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-color-swatches__container-{{ ai_gen_id }}">
    {% if block.settings.label != blank %}
      <div class="ai-color-swatches__label-{{ ai_gen_id }}">
        {{ block.settings.label }}
      </div>
    {% endif %}

    <div class="ai-color-swatches__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign color_name_key = 'color_' | append: i | append: '_name'
          assign color_hex_key = 'color_' | append: i | append: '_hex'
          assign color_url_key = 'color_' | append: i | append: '_url'
          
          assign color_name = block.settings[color_name_key]
          assign color_hex = block.settings[color_hex_key]
          assign color_url = block.settings[color_url_key]
        %}

        {% if color_name != blank and color_hex != blank and color_url != blank %}
          {% assign is_active = false %}
          {% if product.url == color_url or request.path == color_url %}
            {% assign is_active = true %}
          {% endif %}

          <a
            href="{{ color_url }}"
            class="ai-color-swatches__swatch-{{ ai_gen_id }} {% if is_active %}ai-color-swatches__swatch-{{ ai_gen_id }}--active{% endif %}"
            aria-label="{{ color_name }}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            <span
              class="ai-color-swatches__color-{{ ai_gen_id }}"
              style="background-color: {{ color_hex }};"
            ></span>
            {% if block.settings.show_tooltip %}
              <span class="ai-color-swatches__tooltip-{{ ai_gen_id }}">
                {{ color_name }}
              </span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

